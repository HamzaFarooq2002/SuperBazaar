# Copy to `.env` for local development. On Vercel, set these in Project Settings → Environment Variables.

# Main Express API (Render). Origin only is OK — `/api` is appended by src/services/api.js
VITE_BACKEND_URL=http://localhost:5000

# Optional: FastAPI credit ML service URL (used server-side on Render as FASTAPI_URL; reserved for future client use)
VITE_CREDIT_API_URL=http://localhost:8000

# Legacy alias — full base URL including /api (still supported)
# VITE_API_URL=http://localhost:5000/api
